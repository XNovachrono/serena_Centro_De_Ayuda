El archivo docker-compose.yml permite levantar la solución completa en  contenedores:
```yaml
version: '3.8'


services:
  db:
    image: mcr.microsoft.com/mssql/server:2022-latest
    container_name: serena_db
    environment:
      - ACCEPT_EULA=Y
      - SA_PASSWORD=YourSecurePassword123!
    ports:
      - "1433:1433"


  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: serena_backend
    environment:
      - SERENA_CONNECTION_STRING=Server=db;Database=SerenaDb;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=True;
    ports:
      - "5185:5185"
    depends_on:
      - db


  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: serena_frontend
    ports:
      - "3000:3000"
    depends_on:
      - backend
```


